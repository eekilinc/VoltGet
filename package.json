{
  "name": "voltget",
  "version": "1.0.11",
  "description": "VoltGet - High-Speed Download Manager & Media Sniffer (IDM Alternative for Modern Web)",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron dist/electron/main.js\"",
    "dev:vite": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && electron dist/electron/main.js",
    "start": "npm run build:electron && npm run build:renderer && cross-env ELECTRON_IS_DEV=0 electron dist/electron/main.js",
    "start:dev": "cross-env ELECTRON_IS_DEV=0 npm run dev:electron",
    "build": "tsc -p tsconfig.electron.json && vite build && electron-builder",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"fs.copyFileSync('electron/preload.cjs', 'dist/electron/preload.cjs'); if(fs.existsSync('bin/yt-dlp.exe')){fs.mkdirSync('dist/bin',{recursive:true});fs.copyFileSync('bin/yt-dlp.exe','dist/bin/yt-dlp.exe');} if(fs.existsSync('extension')) fs.cpSync('extension','dist/extension',{recursive:true}); if(fs.existsSync('extension-firefox')) fs.cpSync('extension-firefox','dist/extension-firefox',{recursive:true});\"",
    "build:nm_host": "tsc --project tsconfig.electron.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint .",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "prepare": "husky"
  },
  "keywords": [
    "download manager",
    "yt-dlp",
    "ffmpeg",
    "video downloader"
  ],
  "author": "VoltGet",
  "license": "MIT",
  "build": {
    "appId": "com.voltget.app",
    "productName": "VoltGet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**/*",
      "dist/renderer/**/*",
      "dist/bin/**/*",
      "assets/**/*",
      "extension/**/*",
      "extension-firefox/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "extension-firefox",
        "to": "extension-firefox",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^1.6.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "playwright": "^1.45.0",
    "prettier": "^3.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "proxy-agent": "^8.0.2",
    "ws": "^8.21.3",
    "zod": "^4.6.4"
  }
}