{
  "name": "voltget",
  "version": "1.0.0",
  "description": "VoltGet - High-Speed Download Manager & Media Sniffer (IDM Alternative for Modern Web)",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron dist/electron/main.js\"",
    "dev:vite": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && electron dist/electron/main.js",
    "start": "npm run build:electron && npm run build:renderer && cross-env ELECTRON_IS_DEV=0 electron dist/electron/main.js",
    "start:dev": "cross-env ELECTRON_IS_DEV=0 npm run dev:electron",
    "build": "tsc -p tsconfig.electron.json && vite build && electron-builder",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"fs.copyFileSync('electron/preload.cjs', 'dist/electron/preload.cjs')\"",
    "build:nm_host": "tsc --project tsconfig.electron.json",
    "preview": "vite preview"
  },
  "keywords": [
    "download manager",
    "yt-dlp",
    "ffmpeg",
    "video downloader"
  ],
  "author": "VoltGet",
  "license": "MIT",
  "build": {
    "appId": "com.voltget.app",
    "productName": "VoltGet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
